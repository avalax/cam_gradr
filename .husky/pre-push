branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ] && [ -z "$ALLOW_MAIN_PUSH" ]; then
  echo "Direct pushes to main are not allowed (pull request required)."
  echo "Please create a branch and open a pull request, see CONTRIBUTING.md."
  echo "Exception in emergencies: ALLOW_MAIN_PUSH=1 git push"
  exit 1
fi

npm run verify
